<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>
<main>
    <h2 class="titulo">Modificar producto</h2>

    <section class="contProduct" id="cont-updateProduct">
        <form class="formProduct" id="form-updateProduct">
            <label for="prodId">ID del producto:</label>
            <input type="number" id="prodId" name="id" min="1" placeholder="Ej: 1" required>

            <label for="nombre">Nombre:</label>
            <input type="text" id="nombre" name="nombre">

            <label for="precio">Precio:</label>
            <input type="text" id="precio" name="precio" inputmode="decimal">

            <label for="imagen">URL de imagen:</label>
            <input type="text" id="imagen" name="imagen">

            <label for="tipo">Categoría:</label>
            <select id="tipo" name="tipo">
                <option value="" selected>No modificar categoría</option>
                <option value="PC">PC</option>
                <option value="Consola">Consola</option>
            </select>

            <label for="activo">Estado:</label>
            <select id="activo" name="activo">
                <option value="" selected>No modificar estado</option>
                <option value="true">Activo</option>
                <option value="false">Inactivo</option>
            </select>

            <input type="submit" value="Guardar cambios">
        </form>

        <div id="cont-mensaje"></div>
    </section>

    <script src="/js/put.js"></script>
</main>

<%- include("partials/footer.ejs") %>