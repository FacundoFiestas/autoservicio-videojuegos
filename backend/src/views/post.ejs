<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<main>
    <h2 class="titulo"><img src="/assets/post.svg" alt="">Agregar producto</h2>
    <h3 class="subtitulo">Rellene todos los campos del nuevo producto a agregar</h3>
    
    <section class="contProduct" id="cont-createProduct">
        <form class="formProduct" id="form-createProduct">
            
            <label for="prodNombre">Nombre</label>
            <input type="text" name="nombre" id="prodNombre" placeholder="Nombre del producto..." required>

            <label for="prodCategoria">Categoría</label>
            <select name="tipo" id="prodCategoria" required>
                <option value="PC">PC</option>
                <option value="Consola">Consola</option>
            </select>

            <label for="prodPrecio">Precio</label>
            <input type="number" step="0.01" name="precio" id="prodPrecio" min="1" placeholder="Precio del producto..." required>


            <label for="prodImagen">Imagen</label>
            <input type="text" name="imagen" id="prodImagen" placeholder="Imagen del producto..." required>



            <input type="submit" value="Agregar producto">

        </form>
    </section>
    <section id="contenedor-productos"></section>
</main>

<script src="/js/post.js"></script>

<%- include("partials/footer.ejs") %>