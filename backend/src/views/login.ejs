<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AutoGames - Login Administrador</title>

    <link rel="shortcut icon" href="/assets/favicon.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

    <style>
        :root {
            --darkblue: #19274E;
            --lightblue: #5371E9;
            --turquesa: #12989D;
            --bg-dark: #252527;
            --white: #f0f0f0;
            --error: #dc3545;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Jost", sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--white);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        header {
            background-color: var(--darkblue);
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .brand-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-header {
            width: 45px;
            height: 45px;
            object-fit: contain;
        }

        .brand-info h1 {
            font-size: 1.5rem;
            font-weight: 800;
        }

        .alumnos-tag {
            font-size: 0.85rem;
            opacity: 0.85;
        }

        .nav-btn {
            background-color: var(--lightblue);
            color: var(--white);
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 600;
        }

        main {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .login-card {
            background-color: var(--darkblue);
            border: 1px solid var(--lightblue);
            border-radius: 8px;
            padding: 35px 30px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
        }

        .login-card h2 {
            text-align: center;
            font-size: 1.8rem;
            margin-bottom: 8px;
        }

        .login-card p {
            text-align: center;
            font-size: 0.95rem;
            opacity: 0.85;
            margin-bottom: 22px;
        }

        .alerta-error {
            background-color: var(--error);
            color: #ffffff;
            padding: 10px 14px;
            border-radius: 6px;
            margin-bottom: 16px;
            font-size: 0.95rem;
            text-align: center;
        }

        .form-grupo {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 16px;
        }

        .form-grupo label {
            font-weight: 600;
            font-size: 0.95rem;
        }

        .form-grupo input {
            padding: 11px 14px;
            border-radius: 6px;
            border: 1px solid var(--lightblue);
            font-size: 1rem;
            outline: none;
        }

        .acciones-login {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 20px;
        }

        .btn-ingresar {
            background-color: var(--lightblue);
            color: var(--white);
            border: none;
            padding: 12px;
            border-radius: 6px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
        }

        .btn-rapido {
            background-color: var(--turquesa);
            color: var(--white);
            border: none;
            padding: 10px;
            border-radius: 6px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-ingresar:hover, .btn-rapido:hover {
            opacity: 0.9;
        }
    </style>
</head>
<body>
    <header>
        <div class="brand-container">
            <img class="logo-header" src="/assets/logo.png" alt="Logo AutoGames">
            <div class="brand-info">
                <h1>AutoGames — Admin</h1>
                <span class="alumnos-tag">Desarrollado por: Mariano Sibello & Facundo Fiestas</span>
            </div>
        </div>

        <nav>
            <a href="javascript:history.back()" class="nav-btn">Volver al Autoservicio</a>
        </nav>
    </header>

    <main>
        <section class="login-card">
            <h2>Panel Administrador</h2>
            <p>Ingresá tus credenciales para gestionar el catálogo y las ventas.</p>

            <% if (error) { %>
                <div class="alerta-error"><%= error %></div>
            <% } %>

            <form action="/dashboard/login" method="POST">
                <div class="form-grupo">
                    <label for="email">Correo electrónico</label>
                    <input type="email" id="email" name="email" placeholder="admin@autogames.com" required>
                </div>

                <div class="form-grupo">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password" placeholder="••••••••" required>
                </div>

                <div class="acciones-login">
                    <button type="submit" class="btn-ingresar">Ingresar</button>
                    <button type="button" id="btn-acceso-rapido" class="btn-rapido">
                        Acceso Rápido (Autocompletar Demo)
                    </button>
                </div>
            </form>
        </section>
    </main>

    <script>
        document.getElementById("btn-acceso-rapido").addEventListener("click", () => {
            document.getElementById("email").value = "admin@autogames.com";
            document.getElementById("password").value = "admin123";
        });
    </script>
</body>
</html>