<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<main>
    <h2 class="titulo"><img src="/assets/delete.svg" alt="">Eliminar producto</h2>
    <h3 class="subtitulo">Ingrese la ID del producto para eliminarlo</h3>

    <section class="contProduct" id="cont-deleteProduct">
        <form class="formProduct" id="form-deleteProduct">
            <label for="prodId">ID del producto a eliminar:</label>
            <input type="number" id="prodId" name="id" min="1" placeholder="Ej: 1" required>
            <input type="submit" value="Eliminar producto">
        </form>

        <div id="cont-mensaje"></div>
    </section>

    <section id="modal-confirmar" class="modal-overlay" hidden>
        <div class="modal-contenido">
            <p>¿Eliminar el producto con ID <span id="confirm-prodId"></span>?</p>
            <div class="modal-acciones">
                <button type="button" id="btn-confirmarEliminar">Sí, eliminar</button>
                <button type="button" id="btn-cancelarEliminar">Cancelar</button>
            </div>
        </div>
    </section>

    <script src="/js/delete.js"></script>
</main>

<%- include("partials/footer.ejs") %>